#-------------------------------------------------------------------------------
# Configure GCC installation path, and GCC version.
# To execute "arm-none-eabi-gcc -v" in command line can get the current gcc version 
#-------------------------------------------------------------------------------
GCC_INSTALL_PATH=C:\Program Files (x86)\CodeSourcery\Sourcery_CodeBench_Lite_for_ARM_EABI
GCC_VERSION=4.7.2

C_PREDEF=-D __CUSTOMER_CODE__


#-------------------------------------------------------------------------------
# Configure version and out target
#-------------------------------------------------------------------------------
PLATFORM = APPGS3MD
MEMORY   = M32
VERSION  = A01
TARGET   = $(strip $(PLATFORM))$(strip $(MEMORY))$(strip $(VERSION))

#-------------------------------------------------------------------------------
# Configure the include directories
#-------------------------------------------------------------------------------
INCS =  -I $(ENV_INC)
INCS += -I ./           \
        -I include      \
        -I ril/inc      \
        -I custom/config   \
        -I custom/fota/inc \
        -I custom       \
        -I custom/uart  \
        -I custom/param \
        -I custom/gpio  \
        -I custom/com   \
        -I custom/sms   \
        -I custom/oled  \
        -I custom/i2c_scanner \
        -I custom/i2c_bus \
        -I custom/io_expander \
        -I custom/debug \

		



#-------------------------------------------------------------------------------
# Configure source code dirctories
#-------------------------------------------------------------------------------
SRC_DIRS=custom     \
         custom\config     \
         custom\fota\src   \
         custom\uart       \
         custom\param      \
         custom\gpio       \
         custom\com        \
         custom\sms        \
         custom\board      \
         custom\logic      \
         custom\oled       \
         custom\i2c_scanner \
         custom\i2c_bus    \
         custom\io_expander \
         custom\debug      \
         ril\src    \



#-------------------------------------------------------------------------------
# Configure source code files to compile in the source code directories
#-------------------------------------------------------------------------------
SRC_SYS=$(wildcard custom/config/*.c)
SRC_SYS_RIL=$(wildcard ril/src/*.c)
#SRC_EXAMPLE=$(wildcard example/*.c)
SRC_CUS=$(wildcard custom/*.c)
SRC_FOTA=$(wildcard custom/fota/src/*.c)
SRC_UART=$(wildcard custom/uart/*.c)
SRC_PARAM=$(wildcard custom/param/*.c)
SRC_GPIO=$(wildcard custom/gpio/*.c)
SRC_COM=$(wildcard custom/com/*.c)
SRC_SMS=$(wildcard custom/sms/*.c)
SRC_BOARD=$(wildcard custom/board/*.c)
SRC_LOGIC=$(wildcard custom/logic/*.c)
SRC_OLED=$(wildcard custom/oled/*.c)
SRC_I2C_SCANNER=$(wildcard custom/i2c_scanner/*.c)
SRC_I2C_BUS=$(wildcard custom/i2c_bus/*.c)
SRC_IO_EXPANDER=$(wildcard custom/io_expander/*.c)
SRC_DEBUG=$(wildcard custom/debug/*.c)


OBJS=\
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_SYS))        \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_SYS_RIL))    \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_CUS))        \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_FOTA))       \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_UART))       \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_PARAM))      \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_GPIO))       \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_COM))        \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_SMS))        \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_BOARD))      \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_LOGIC))      \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_OLED))       \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_I2C_SCANNER)) \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_I2C_BUS))    \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_IO_EXPANDER)) \
	 $(patsubst %.c, $(OBJ_DIR)/%.o, $(SRC_DEBUG))      \



#-------------------------------------------------------------------------------
# Configure user reference library
#-------------------------------------------------------------------------------
USERLIB=libs/gcc/app_start.lib

.PHONY: all
all:
#	$(warning <-- make all, C_PREDEF=$(C_PREDEF) -->)
	@$(MAKE) new -f make/gcc/gcc_makefile

include make\gcc\gcc_makefiledef

export GCC_INSTALL_PATH C_PREDEF OBJS USERLIB SRC_DIRS
